<ul>
  <li>
    <h3>予定一覧</h3>
  </li>
  <li>
    <p><%= link_to "＋新規作成", :new_plan %></p>
  </li>
</ul>
<% if flash[:notice] %>
  <p class = "notice"><%= flash[:notice] %></p>
<% end %>

<table class = "planList">
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
    </tr>
  </thead>

  <tbody>
    <% @plans.each do |plan| %>
      <tr>
        <td><%= plan.id %></td>
        <td><%= plan.title %></td>
        <td><%= plan.start_day %></td>
        <td><%= plan.finish_day %></td>
        <td><%= plan.all_day? ? "◯" : "" %></td>
        <td><%= plan.updated_at.to_fs(:datetime_jp) %></td>
        <td>
          <%= link_to "詳細", plan %>
        </td>
        <td>
          <%= link_to "編集", [:edit, plan] %>
        </td>
        <td>
          <%= link_to "削除", plan, data: {turbo_method: :delete, turbo_confirm: "本当に削除しますか？"} %>
        </td>

      </tr>
    <% end %>
  </tbody>
</table>


    
      

