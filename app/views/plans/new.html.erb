<h3>新規の予定を作成</h3>
<%= render "shared/error", obj: @plan %>

<%= form_with model: @plan do |f| %>
  <table class = "newSchedule">
    <tr>
      <th><%= f.label :title ,"タイトル" %></th>
      <td><%= f.text_field :title %></td>
    </tr>
    <tr>
      <th><%= f.label :start_day ,"開始日" %></th>
      <td><%= f.date_field :start_day %></td>
      <th><%= f.label :finish_day ,"終了日" %></th>
      <td><%= f.date_field :finish_day %></td>
    </tr>
     <tr>
      <th><%= f.label :memo ,"スケジュールメモ" %></th>
      <td><%= f.text_area :memo %></td>
    </tr>
  </table>
  <div class = "checkbox">
    <%= f.check_box :all_day %>
      終日の場合はチェックを入れます
  </div>
  <div>
    <ul>
      <li><%= link_to "キャンセル", :plans %></li>
      <li><%= f.submit "保存" %></li>
    </ul>
<% end %>